# Copy this file to .env and change the values.
# Never commit .env: it holds your secrets (it is listed in .gitignore).

# PostgreSQL connection URL (required).
# On Render: set it in the web service's Environment settings (use the
#            database's *Internal* Database URL).
# Locally:   use the database's *External* Database URL from Render,
#            or a PostgreSQL server on your own computer.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Secret used to sign login tokens (any long random text)
JWT_SECRET=change-this-to-a-long-random-string

# Port the server runs on (Render sets this automatically)
PORT=3000

# Optional, used for the "Explain in simple words" button.
# Leave empty: the app works fully without it.
ANTHROPIC_API_KEY=
